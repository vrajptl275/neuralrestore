# ═══════════════════════════════════════════════════════
# NeuralRestore — .gitignore
# ═══════════════════════════════════════════════════════

# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/
*.pyo

# ── Virtual Environments ──────────────────────────────
venv/
env/
.env/
.venv/
conda-env/

# ── IDE / Editor ──────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.spyderproject
.spyproject
.ropeproject

# ── OS Generated ─────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Model Weights (large binary files) ───────────────
weights/*.pth
weights/.cache/
!weights/.gitkeep

# ── Output Files ─────────────────────────────────────
outputs/*
!outputs/.gitkeep

# ── Data (too large for git) ─────────────────────────
data/

# ── Jupyter ──────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Logs & Misc ──────────────────────────────────────
*.log
*.tmp
*.bak

# ── Antigravity / Gemini ─────────────────────────────
.kilo/
